# Настройки приложения
APP_NAME=Local Catalog API
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_DB=local_catalog
POSTGRES_USER=local_catalog
POSTGRES_PASSWORD=replace_me_with_a_strong_password
DATABASE_URL=postgresql+asyncpg://local_catalog:replace_me_with_a_strong_password@localhost:5432/local_catalog

# Telegram Mini App
BOT_TOKEN=replace_me_with_the_token_from_BotFather
ADMIN_IDS=123456789,987654321
MANAGER_TELEGRAM_ID=123456789
INIT_DATA_MAX_AGE_SECONDS=86400
MINI_APP_URL=https://shop.example.com
CITY_TIMEZONE=Europe/Minsk
UPLOADS_DIR=uploads

# CORS: укажите адреса фронтенда через запятую
CORS_ORIGINS=http://localhost:5173,https://shop.example.com

# Публичный адрес приложения
PUBLIC_BASE_URL=https://shop.example.com

# Public HTTPS host for Caddy on the VPS
DOMAIN=shop.example.com
ACME_EMAIL=owner@example.com
